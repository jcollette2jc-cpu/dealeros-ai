generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model Vehicle {
  id                 Int                 @id @default(autoincrement())
  stockNumber        String              @unique
  vin                String              @unique
  year               Int
  make               String
  model              String
  trim               String?
  mileage            Int                 @default(0)
  dateIn             DateTime?
  retailPrice        Decimal             @default(0)
  vehicleCost        Decimal             @default(0)
  reconCost          Decimal             @default(0)
  otherCost          Decimal             @default(0)
  color              String?
  status             String              @default("Available")
  notes              String?
  archivedAt         DateTime?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  leads              Lead[]
  marketingApprovals MarketingApproval[]

  @@index([status, archivedAt])
  @@index([dateIn])
}

model Lead {
  id             Int       @id @default(autoincrement())
  firstName      String
  lastName       String?
  email          String?
  phone          String?
  source         String    @default("Manual")
  status         String    @default("New")
  priority       String    @default("Warm")
  vehicleId      Int?
  vehicle        Vehicle?  @relation(fields: [vehicleId], references: [id], onDelete: SetNull)
  lastContactAt  DateTime?
  nextFollowUpAt DateTime?
  appointmentAt  DateTime?
  respondedAt    DateTime?
  notes          String?
  archivedAt     DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([status, archivedAt])
  @@index([nextFollowUpAt])
  @@index([vehicleId])
}

model MarketingApproval {
  id         Int      @id @default(autoincrement())
  vehicleId  Int
  vehicle    Vehicle  @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  channel    String
  status     String   @default("Draft")
  approvedAt DateTime?
  updatedAt  DateTime @updatedAt
  createdAt  DateTime @default(now())

  @@unique([vehicleId, channel])
  @@index([status])
}