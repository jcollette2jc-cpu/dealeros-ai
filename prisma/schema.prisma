generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model Vehicle {
  id          Int       @id @default(autoincrement())
  stockNumber String    @unique
  vin         String    @unique
  year        Int
  make        String
  model       String
  trim        String?
  mileage     Int       @default(0)
  dateIn      DateTime?
  retailPrice Decimal   @default(0)
  vehicleCost Decimal   @default(0)
  reconCost   Decimal   @default(0)
  otherCost   Decimal   @default(0)
  color       String?
  status      String    @default("Available")
  notes       String?
  archivedAt  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([status, archivedAt])
  @@index([dateIn])
}
