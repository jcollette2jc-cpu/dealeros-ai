generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model Vehicle {
  id                 Int                 @id @default(autoincrement())
  stockNumber        String              @unique
  vin                String              @unique
  year               Int
  make               String
  model              String
  trim               String?
  mileage            Int                 @default(0)
  dateIn             DateTime?
  retailPrice        Decimal             @default(0)
  vehicleCost        Decimal             @default(0)
  reconCost          Decimal             @default(0)
  otherCost          Decimal             @default(0)
  color              String?
  status             String              @default("Available")
  notes              String?
  archivedAt         DateTime?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  leads              Lead[]
  marketingApprovals MarketingApproval[]
  photos             VehiclePhoto[]

  @@index([status, archivedAt])
  @@index([dateIn])
}

model VehiclePhoto {
  id        Int      @id @default(autoincrement())
  vehicleId Int
  vehicle   Vehicle  @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  url       String
  altText   String?
  position  Int      @default(0)
  isPrimary Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([vehicleId, position])
}

model Lead {
  id             Int           @id @default(autoincrement())
  firstName      String
  lastName       String?
  email          String?
  phone          String?
  source         String        @default("Manual")
  status         String        @default("New")
  priority       String        @default("Warm")
  vehicleId      Int?
  vehicle        Vehicle?      @relation(fields: [vehicleId], references: [id], onDelete: SetNull)
  lastContactAt  DateTime?
  nextFollowUpAt DateTime?
  appointmentAt  DateTime?
  respondedAt    DateTime?
  notes          String?
  archivedAt     DateTime?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  activities     LeadActivity[]

  @@index([status, archivedAt])
  @@index([nextFollowUpAt])
  @@index([vehicleId])
}

model LeadActivity {
  id        Int      @id @default(autoincrement())
  leadId    Int
  lead      Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  type      String
  summary   String
  createdAt DateTime @default(now())

  @@index([leadId, createdAt])
}

model MarketingApproval {
  id         Int      @id @default(autoincrement())
  vehicleId  Int
  vehicle    Vehicle  @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  channel    String
  status     String   @default("Draft")
  approvedAt DateTime?
  updatedAt  DateTime @updatedAt
  createdAt  DateTime @default(now())

  @@unique([vehicleId, channel])
  @@index([status])
}

model DealershipSettings {
  id                  Int      @id @default(1)
  name                String   @default("Reliable Auto Sales")
  phone               String?
  email               String?
  website             String?
  streetAddress       String   @default("9423 Lima Rd.")
  city                String   @default("Fort Wayne")
  state               String   @default("IN")
  postalCode          String?
  financingDisclosure String   @default("Financing options may be available for qualified buyers.")
  updatedAt           DateTime @updatedAt
  createdAt           DateTime @default(now())
}
